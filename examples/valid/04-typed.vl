// Example: type annotations on spaces, literals, and variables
defmodule TypedExample

// Spaces with explicit base-type annotations (new syntax)
defspace IntSpace : Int end
defspace BoolSpace : Bool end
defspace CharSpace : Char end

// Spaces without annotation (original syntax)
defspace Nat < IntSpace end

// Operators – type chain references declared spaces
defoperator zero : IntSpace end
defoperator succ : IntSpace -> IntSpace end
defoperator isZero : IntSpace -> BoolSpace end
defoperator add : IntSpace -> IntSpace -> IntSpace [ associative id : zero ] end

// Variables typed to declared spaces
defvar n : IntSpace , m : IntSpace , b : BoolSpace end

// Rewrite rules using operator applications
defrule (add (succ n) m) -> (succ (add n m)) end

// Expressions using typed literals (new syntax: Literal:Type)
defexpression forall n in IntSpace . (isZero 0:IntSpace) end

// Expressions using boolean literals
defexpression exists b in BoolSpace . (isZero (succ zero)) end

end
